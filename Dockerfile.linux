# Linux desktop packager for AppImage and .deb.
# Build context is scripts/ so the entrypoint can be copied without a root .dockerignore.
FROM docker.io/library/node:24-bookworm

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    binutils \
    ca-certificates \
    curl \
    dpkg \
    fakeroot \
    file \
    g++ \
    git \
    gnupg \
    libarchive-tools \
    libfuse2 \
    make \
    python3 \
    rpm \
    rsync \
    unzip \
    wget \
    xz-utils \
  && rm -rf /var/lib/apt/lists/*

RUN corepack enable

COPY linux-builder-entrypoint.sh /usr/local/bin/openpos-linux-build
RUN chmod +x /usr/local/bin/openpos-linux-build

WORKDIR /project
ENTRYPOINT ["/usr/local/bin/openpos-linux-build"]
