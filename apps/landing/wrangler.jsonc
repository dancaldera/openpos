{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Static Astro site on Workers static assets.
  "name": "openpos-landing",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./dist", "not_found_handling": "404-page" },
  "routes": [{ "pattern": "pos.softmelody.dev", "custom_domain": true }],
  "workers_dev": false
}
