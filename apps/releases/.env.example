# OpenPOS releases environment template
#
# Copy to `.env` for `pnpm run release` (uploads) and `pnpm run dev:releases`
# (local Node proxy). In production the releases Worker reads the R2 bucket
# through its binding and needs none of these.
#
# Values come from an R2 API token with Object Read & Write on the
# openpos-releases bucket (Cloudflare dashboard > R2 > Manage API tokens).
# AWS_S3_BUCKET, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_REGION,
# and AWS_S3_ENDPOINT are accepted as fallbacks of the names below.

BUCKET=openpos-releases
ACCESS_KEY_ID=replace-with-access-key-id
SECRET_ACCESS_KEY=replace-with-secret-access-key

# R2 uses region `auto` and an account-scoped endpoint.
REGION=auto
ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# Public URL written into latest.json.
RELEASE_CDN_BASE_URL=https://releases.pos.softmelody.dev

# Optional for the local Node proxy. Defaults to 3100.
PORT=3100
