# OpenPOS releases proxy environment template
#
# Copy to `.env` for local runs (`pnpm run dev:releases`) and for
# `pnpm run release`, which maps these Railway bucket names to the
# upload variables. On Railway, set these as variable references
# from the `openpos-releases` bucket in the same project:
#   BUCKET=${{openpos-releases.BUCKET}}
#   ACCESS_KEY_ID=${{openpos-releases.ACCESS_KEY_ID}}
#   SECRET_ACCESS_KEY=${{openpos-releases.SECRET_ACCESS_KEY}}
#   REGION=${{openpos-releases.REGION}}
#   ENDPOINT=${{openpos-releases.ENDPOINT}}
#
# AWS_S3_BUCKET, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_REGION,
# and AWS_S3_ENDPOINT are accepted as fallbacks of the names below.

# S3 bucket name from the Railway bucket credentials (not the resource label).
BUCKET=your-openpos-releases-bucket

# S3 credentials from the same Railway bucket.
ACCESS_KEY_ID=replace-with-access-key-id
SECRET_ACCESS_KEY=replace-with-secret-access-key

# Railway buckets use `auto` and the Storage API endpoint.
REGION=auto
ENDPOINT=https://t3.storageapi.dev

# Optional for standalone local/server deployments. Railway injects PORT.
# Defaults to 3100.
PORT=3100
