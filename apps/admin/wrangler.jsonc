{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Root admin: stores, Turso databases, connection keys, and domains.
  // Put Cloudflare Access in front of admin.pos.softmelody.dev as a second gate.
  "name": "openpos-admin",
  "main": "src/worker.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "admin.pos.softmelody.dev", "custom_domain": true }],
  "workers_dev": false,
  "observability": { "enabled": true },
  "vars": {
    "STORE_BASE_DOMAINS": "pos.softmelody.dev",
    "STORE_WEB_URL_TEMPLATE": "https://{slug}.pos.softmelody.dev",
    "PUBLIC_API_URL": "https://api.pos.softmelody.dev",
    "RELEASES_URL": "https://releases.pos.softmelody.dev",
    "TURSO_ORG": "dancaldera",
    "TURSO_GROUP": "openpos",
    "CLOUDFLARE_ACCOUNT_ID": "b220599d0d0231c40573c209405f1a00",
    "CLOUDFLARE_ZONE_NAME": "softmelody.dev",
    "WEB_WORKER_NAME": "openpos-web"
  }
  // Secrets (wrangler secret put <NAME>):
  //   CONTROL_PLANE_URL, CONTROL_PLANE_AUTH_TOKEN, CONTROL_PLANE_SECRET (same values as the API),
  //   ADMIN_SESSION_SECRET, ADMIN_SETUP_TOKEN (only until the first root exists), TURSO_API_TOKEN,
  //   CLOUDFLARE_API_TOKEN (Workers Scripts: Edit) to publish store web addresses.
}
