{
  "name": "@openpos/admin",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "description": "Root admin for OpenPOS stores, Turso databases, and domains",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "dev:worker": "wrangler dev",
    "seed:dev": "tsx src/dev-seed.ts",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "check": "biome check src && tsc -p tsconfig.json",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@openpos/control-plane": "workspace:*",
    "hono": "^4.13.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@libsql/client": "^0.15.15",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "4.1.10",
    "tsx": "^4.23.12",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.158.0"
  }
}
