# OpenPOS API environment template
#
# Required. Signs JWTs and encrypts stored credentials (S3 keys, Turso tokens).
JWT_SECRET=replace-with-a-long-random-secret

# Required. Operator secret for password recovery and other administration.
INTERNAL_SECRET=replace-with-a-long-random-admin-secret

# Optional for deployed browser clients (comma-separated origins).
# If omitted, localhost dev origins remain allowed.
ALLOWED_ORIGIN=https://your-openpos-web.up.railway.app

# Recommended for deployed web/API instances. These stay server-side; the web
# app discovers only non-secret store metadata from the API.
TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io
TURSO_AUTH_TOKEN=replace-with-a-database-token

# Optional for standalone local/server deployments.
PORT=3001
