# OpenPOS API environment template for running the Node server outside
# `pnpm run dev` (which generates all of these under .dev-data/).
# On Cloudflare these are Worker secrets; see docs/CLOUDFLARE.md.

# Required. Control plane database that maps stores to their Turso databases.
CONTROL_PLANE_URL=libsql://openpos-control-plane-your-org.turso.io
CONTROL_PLANE_AUTH_TOKEN=replace-with-a-database-token
# Required. Encrypts store database tokens. Must match the admin app.
CONTROL_PLANE_SECRET=replace-with-a-long-random-secret

# Required. Signs JWTs and encrypts stored credentials (S3 keys).
JWT_SECRET=replace-with-a-long-random-secret

# Required. Operator secret for password recovery and other administration.
INTERNAL_SECRET=replace-with-a-long-random-admin-secret

# Base domains whose subdomains are store slugs (aldo.pos.softmelody.dev -> aldo).
STORE_BASE_DOMAINS=pos.softmelody.dev

# Optional. Browser origins allowed by CORS (comma-separated, * wildcards allowed).
ALLOWED_ORIGIN=https://*.pos.softmelody.dev

# Optional. Store slug for requests that carry no key, token, or store host
# (single-store hosting).
# DEFAULT_STORE=demo

# Optional. Defaults to 3001.
PORT=3001
