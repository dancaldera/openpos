# References to the ID vault (https://id.softmelody.dev). No secret values here.
# Run a command with them:  idv run -- <command>
# Check they resolve:       idv run --check

# Turso Platform API token limited to the "openpos" group
# (read, db:create, db:delete, db:mint-token, db:rotate-creds).
TURSO_API_TOKEN=idv://openpos-turso/TURSO_API_TOKEN
TURSO_ORG=dancaldera
TURSO_GROUP=openpos
